rules_version = '2';

// Personal Helper access rules. Paste into Firebase console > Firestore Database > Rules, after replacing
// OWNER_UID with your uid (the web app shows it on the sign-in error and on Settings).
//
// Everything lives under users/{uid}. Only the owner's signed-in Google account can read or write it.
// The PC guardian and the Cloudflare Worker use a service account, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && uid == 'OWNER_UID';
    }
  }
}
